{
  "name": "wee-check-ap",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "predev": "vite build",
    "dev": "node scripts/dev.mjs",
    "setup:ap": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/configure-windows-firewall.ps1",
    "teardown:ap": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/remove-windows-firewall.ps1",
    "dev:web": "vite --host 127.0.0.1 --strictPort",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build && tsc -p server/tsconfig.json",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-package.ps1",
    "installer:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-installer.ps1",
    "portable:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-portable.ps1",
    "start": "node server-dist/server/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "latest",
    "@fastify/rate-limit": "latest",
    "@fastify/static": "latest",
    "@primno/dpapi": "latest",
    "argon2": "latest",
    "better-sqlite3": "latest",
    "fastify": "latest",
    "qrcode": "latest"
  },
  "devDependencies": {
    "@types/better-sqlite3": "latest",
    "@types/node": "latest",
    "@types/qrcode": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  },
  "overrides": {}
}
